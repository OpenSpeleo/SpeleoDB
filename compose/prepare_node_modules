#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

node_modules_dir="${SPELEODB_NODE_MODULES_DIR:-/app/node_modules}"
node_modules_user="${SPELEODB_NODE_MODULES_USER:-dev-user}"
node_modules_group="${SPELEODB_NODE_MODULES_GROUP:-${node_modules_user}}"

mkdir -p "${node_modules_dir}"

expected_uid="$(id -u "${node_modules_user}")"
expected_gid="$(getent group "${node_modules_group}" | cut -d: -f3)"
current_ownership="$(stat -c '%u:%g' "${node_modules_dir}")"
expected_ownership="${expected_uid}:${expected_gid}"

if [[ "${current_ownership}" == "${expected_ownership}" ]]; then
    echo "Node dependency volume ownership is already current."
    exit 0
fi

if [[ "$(id -u)" != "0" ]]; then
    echo "Node dependency volume ownership requires a root migration." >&2
    exit 1
fi

echo "Migrating Node dependency volume ownership to ${node_modules_user}:${node_modules_group}."
chown -R "${node_modules_user}:${node_modules_group}" "${node_modules_dir}"
