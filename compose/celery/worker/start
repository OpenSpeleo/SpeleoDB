#!/bin/bash

set -o errexit
set -o nounset
set -o pipefail

# Each execution slot starts with one numerical-library thread. Operators can
# explicitly increase an individual library limit after measuring their workload.
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-1}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-1}"
export NUMEXPR_NUM_THREADS="${NUMEXPR_NUM_THREADS:-1}"
export VECLIB_MAXIMUM_THREADS="${VECLIB_MAXIMUM_THREADS:-1}"
export BLIS_NUM_THREADS="${BLIS_NUM_THREADS:-1}"

# Keep full Django validation in a short-lived process. The worker can then load
# its models and tasks without retaining the checks' URL and admin import graph.
SPELEODB_CELERY_WORKER_RUNTIME=false python manage.py check
export SPELEODB_CELERY_WORKER_RUNTIME=true

# Explicit restarts preserve long-running export attempts during development.
# Host-networked Compose replicas share %h, so each worker needs its own name.
read -r worker_id < /proc/sys/kernel/random/uuid
exec celery -A config.celery_app --skip-checks worker --loglevel INFO --events \
    --queues exports,background_control --concurrency 1 --prefetch-multiplier 1 \
    --hostname "worker-${worker_id}@%h"
