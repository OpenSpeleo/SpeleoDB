#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset

python manage.py migrate

# Install the root asset workspace.
test -s bun.lock && bun install --frozen-lockfile || exit "$?"

# Vite rebuilds assets to disk while TypeScript checks semantics. The supervisor
# keeps all streams attached, forwards signals and awaits child process groups;
# Django remains the only HTTP server.
exec bun scripts/dev.ts --django
