#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset

python manage.py migrate

# Install the root asset workspace.
if [[ "${SPELEODB_LOCAL_PACKAGES:-0}" == "1" ]]; then
    : "${SPELEODB_PACKAGE_INSTALLER:?Local package mode requires the monorepo installer}"
    bun "$SPELEODB_PACKAGE_INSTALLER"
else
    test -s bun.lock || exit "$?"
    bun scripts/check-shared-package-pins.ts
    bun install --frozen-lockfile
fi

# Frontend assets are rebuilt explicitly with `bun run build`, followed by a
# manual browser refresh. Django remains the only HTTP server.
exec python manage.py runserver_plus 0000:8000
