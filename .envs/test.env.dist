# Do not read .env files
DJANGO_READ_DOT_ENV_FILE=False

# Test repositories use generated UUID paths below a bind mount. Git 2.39 does
# not support a recursive safe.directory pattern, so trust is broadened only in
# test processes rather than for the whole development container.
GIT_CONFIG_COUNT=1
GIT_CONFIG_KEY_0=safe.directory
GIT_CONFIG_VALUE_0=*

# Test Database
# Select PostgreSQL explicitly, using the local service address in either
# standalone host networking or monorepo Compose. A private literal URL wins.
DATABASE_URL=postgresql://${POSTGRES_USER:-debug}:${POSTGRES_PASSWORD:-debug}@${POSTGRES_HOST:-localhost}:${POSTGRES_PORT:-5432}/${POSTGRES_DB:-speleodb}

# Real-worker tests run by default against the dedicated celery-test-redis
# service. Ordinary tests use in-memory transport. Override only when the test
# service address differs from localhost:6381 (for example Compose networking).
# TEST_CELERY_BROKER_URL=redis://localhost:6381/0


# AWS S3 Configuration
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=access_key
AWS_SECRET_ACCESS_KEY=secret_key
AWS_STORAGE_BUCKET_NAME=speleodb-user-artifacts-test
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_BROWSER_ENDPOINT_URL=http://localhost:9000
AWS_S3_USE_SSL=False
AWS_S3_VERIFY=False
AWS_S3_ADDRESSING_STYLE="path"
AWS_S3_CUSTOM_DOMAIN="localhost:9000/${AWS_STORAGE_BUCKET_NAME}"


# MAPBOX Configuration
# ------------------------------------------------------------------------------
MAPBOX_API_TOKEN=<placeholder>


# GITLAB Configuration
# ------------------------------------------------------------------------------
GITLAB_GROUP_ID=<placeholder>
GITLAB_GROUP_NAME=<placeholder>
GITLAB_HOST_URL=localhost:9080
GITLAB_TOKEN=<placeholder>
