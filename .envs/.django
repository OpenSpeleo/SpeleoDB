# General
# ------------------------------------------------------------------------------
USE_DOCKER=True
IPYTHONDIR=/app/.ipython

# Redis
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# Celery
# ------------------------------------------------------------------------------
# CELERY_BROKER_URL is interpolated from the private root .env in local.yml.

# GitLab (local Compose service)
# ------------------------------------------------------------------------------
GITLAB_HOST_URL=localhost:9080
# GITLAB_GROUP_NAME is interpolated from the private root .env in local.yml.
# GITLAB_GROUP_ID and GITLAB_TOKEN are provisioned into the ignored .env file.

# RustFS / S3-compatible local object storage
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=access_key
AWS_SECRET_ACCESS_KEY=secret_key
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_CUSTOM_DOMAIN=localhost:9000/speleodb-user-artifacts-dev
# AWS_STORAGE_BUCKET_NAME is provisioned into the ignored .env file.

# Django
# -------------------------------------------------------------------------------
DJANGO_DEBUG=True
DJANGO_SECRET_KEY="1!(kim5&o=o6iu8gdmp%b4r6+pphg%_kgt*nd^k=k#88d6vyq3"
