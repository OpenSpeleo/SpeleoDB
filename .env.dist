# AWS S3 Configuration
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=access_key
AWS_SECRET_ACCESS_KEY=secret_key
AWS_STORAGE_BUCKET_NAME=speleodb-user-artifacts-dev
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_BROWSER_ENDPOINT_URL=http://localhost:9000
AWS_S3_USE_SSL=False
AWS_S3_VERIFY=False
AWS_S3_ADDRESSING_STYLE="path"
AWS_S3_CUSTOM_DOMAIN="localhost:9000/${AWS_STORAGE_BUCKET_NAME}"

# MAPBOX Configuration
# ------------------------------------------------------------------------------
MAPBOX_API_TOKEN=<placeholder>

# GITLAB Configuration
# ------------------------------------------------------------------------------
GITLAB_GROUP_ID=<placeholder>
GITLAB_GROUP_NAME=speleodb
GITLAB_HOST_URL=localhost:9080
GITLAB_TOKEN=<placeholder>

# Background exports and local Kanchi (local-only defaults)
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
KANCHI_CELERY_BROKER_URL=redis://redis:6379/1
KANCHI_URL=http://localhost:8765/ui
KANCHI_POSTGRES_PASSWORD=kanchi-local-only
KANCHI_USERNAME=kanchi-local
KANCHI_PASSWORD=kanchi-local-only
KANCHI_SESSION_SECRET_KEY=speleodb-local-session-secret-not-for-production
KANCHI_TOKEN_SECRET_KEY=speleodb-local-token-secret-not-for-production
