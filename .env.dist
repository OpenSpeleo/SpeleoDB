# AWS S3 Configuration
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=access_key
AWS_SECRET_ACCESS_KEY=secret_key
AWS_STORAGE_BUCKET_NAME=speleodb-user-artifacts-dev
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_BROWSER_ENDPOINT_URL=http://localhost:9000
AWS_S3_USE_SSL=False
AWS_S3_VERIFY=False
AWS_S3_ADDRESSING_STYLE="path"
AWS_S3_CUSTOM_DOMAIN="localhost:9000/${AWS_STORAGE_BUCKET_NAME}"

# MAPBOX Configuration
# ------------------------------------------------------------------------------
MAPBOX_API_TOKEN=<placeholder>

# GITLAB Configuration
# ------------------------------------------------------------------------------
GITLAB_GROUP_ID=<placeholder>
GITLAB_GROUP_NAME=speleodb
GITLAB_HOST_URL=localhost:9080
GITLAB_TOKEN=<placeholder>

# Background exports (local-only defaults)
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1

# Full HTTPS donation URL. Leave empty to hide the public donation section.
SPELEODB_DONATION_CAMPAIGN_URL=

# Staging and self-hosted deployments using production settings can set their canonical issuer.
# DJANGO_OIDC_ISSUER=https://stage.speleodb.org
DJANGO_OIDC_ISSUER=http://localhost:8000

# By default False, allows to specify http:// redirection instead of https://
# Intended for testing, should be left False in production.
DJANGO_OIDC_ALLOW_HTTP=true

# Local Compose setup fills in this example automatically. To supply your own key:
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:4096
# Django web server only. In .env, paste the complete PEM between single quotes, preserving every line break.
DJANGO_OIDC_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----
<paste all key lines here>
-----END PRIVATE KEY-----'
